diff --git a/src/wasm.rs b/src/wasm.rs
new file mode 100644
index 0000000..b84e26f
--- /dev/null
+++ b/src/wasm.rs
@@ -0,0 +1,35 @@
+//! wasm-bindgen front end for browsers: the same normalize + G2P pipeline as
+//! the Python `SEAPipeline(lang="vi")`, with the dictionary passed in as bytes.
+use wasm_bindgen::prelude::*;
+use crate::g2p::G2PEngine;
+use crate::lang::vi::Normalizer;
+
+#[wasm_bindgen]
+pub struct SeaG2p { normalizer: Normalizer, engine: G2PEngine }
+
+#[wasm_bindgen]
+impl SeaG2p {
+    /// `dict` = contents of sea_g2p.bin. Only the first call's bytes are kept.
+    #[wasm_bindgen(constructor)]
+    pub fn new(dict: Vec<u8>) -> Result<SeaG2p, JsError> {
+        let _ = crate::core::dict::WASM_DICT.set(std::sync::Arc::from(dict.into_boxed_slice()));
+        let engine = G2PEngine::new("sea_g2p.bin").map_err(|e| JsError::new(&e.to_string()))?;
+        Ok(SeaG2p { normalizer: Normalizer::new("vi", Some("sea_g2p.bin")), engine })
+    }
+    /// Normalisation only (what the chunker measures).
+    pub fn normalize(&self, text: &str, punc_norm: bool) -> String {
+        if text.is_empty() { return String::new(); }
+        self.normalizer.normalize(text, punc_norm)
+    }
+    /// normalize + G2P  ==  SEAPipeline("vi").run(text, punc_norm)
+    pub fn phonemize(&self, text: &str, punc_norm: bool) -> String {
+        if text.is_empty() { return String::new(); }
+        let n = self.normalizer.normalize(text, punc_norm);
+        self.engine.phonemize(&n)
+    }
+    /// G2P on already-normalized text.
+    pub fn g2p(&self, text: &str) -> String { self.engine.phonemize(text) }
+}
+
+#[wasm_bindgen(js_name = puncNorm)]
+pub fn punc_norm(text: &str) -> String { crate::punc::apply_punc_norm(text) }
